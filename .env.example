# Where the Next.js server reaches the NestJS backend (server side only).
# Also used at BUILD time for the /api/v1 and /media rewrites, so set it before `next build`.
API_INTERNAL_URL=http://127.0.0.1:8000

# Public URL of this site, used for canonical URLs, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://alldriveph.com

# Shared with the API (REVALIDATE_SECRET there) so admin edits refresh the public site cache
REVALIDATE_SECRET=change-me-to-a-long-random-string
